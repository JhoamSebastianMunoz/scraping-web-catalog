{
  "compilerOptions": {
    /* Entorno de ejecución */
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],

    /* Rutas del proyecto */
    "outDir": "./dist",
    "rootDir": "./",

    /* Verificación estricta de tipos */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* Compatibilidad de módulos e importaciones */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* Tipos globales */
    "types": ["node"],

    /* Optimización de compilación y librerías de terceros */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}